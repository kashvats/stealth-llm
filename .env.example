# ========================================
# SILENT STRATEGIST - Configuration
# ========================================

# ==========================================
# LLM PROVIDER CONFIGURATION
# ==========================================

# Choose LLM provider: "ollama" (local, free), "colibri" (disk-streamed MoE, free), "llamacpp" (local, free), or "openai" (cloud, paid)
LLM_PROVIDER=ollama

# ==========================================
# COLIBRI CONFIGURATION (Disk-Streamed MoE)
# ==========================================

# Colibri server address (default: http://127.0.0.1:8000)
# Start server with: coli serve
COLIBRI_BASE_URL=http://127.0.0.1:8000

# Optional model name (default: colibri)
COLIBRI_MODEL=colibri

# Optional API key if coli serve was started with an API key
# COLIBRI_API_KEY=your-api-key-here

# ==========================================
# RESOURCE GOVERNOR (Anti-Freeze & Smooth Screen)
# ==========================================

# Automatically lower process priority to BELOW_NORMAL so heavy models
# never starve OS rendering, mouse movement, or the Tkinter screen
RESOURCE_GOVERNOR_ENABLED=true
LOW_PRIORITY_INFERENCE=true

# Keep at least 2 CPU cores 100% free for OS desktop rendering and window manager
RESERVED_CPU_CORES=2

# Minimum physical RAM headroom in MB before warning
MIN_FREE_RAM_MB=1024

# ==========================================
# LLAMA.CPP CONFIGURATION (Local AI)
# ==========================================

# llama.cpp server address (default: localhost:8080)
# Start server with: llama-server -m /path/to/model.gguf --port 8080
LLAMACPP_BASE_URL=http://localhost:8080

# Optional: direct GGUF model path (requires: pip install llama-cpp-python)
# When set, runs in-process instead of connecting to HTTP server
# LLAMACPP_MODEL_PATH=models/llama-3.2-1b-instruct-q4_k_m.gguf

# Optional: API key if llama-server was started with --api-key
# LLAMACPP_API_KEY=your-api-key-here

# ==========================================
# OLLAMA CONFIGURATION (Local AI)
# ==========================================

# Ollama server address (default: localhost)
OLLAMA_BASE_URL=http://localhost:11434

# ==========================================
# OLLAMA MODEL SELECTION (Choose One)
# ==========================================
#
# For 8GB RAM (LIGHTWEIGHT - Recommended):
#   OLLAMA_MODEL=llama3.2:1b          # Tiny, ~2GB VRAM, fast
#   OLLAMA_MODEL=phi:latest           # ~2.5GB VRAM, good quality
#
# For 16GB+ RAM (BALANCED - Default):
#   OLLAMA_MODEL=llama3.2             # Default, ~4-6GB VRAM
#   OLLAMA_MODEL=mistral:latest       # ~4GB VRAM, quality balance
#
# For 32GB+ RAM (PERFORMANCE - High Quality):
#   OLLAMA_MODEL=llama3.1:8b          # ~8GB VRAM, expert level
#   OLLAMA_MODEL=neural-chat:7b       # ~7GB VRAM, optimized
#
# To download new models, run:
#   ollama pull <model-name>
#

OLLAMA_MODEL=llama3.2:1b

# ==========================================
# OPENAI CONFIGURATION (Cloud - Optional)
# ==========================================

# Only required if LLM_PROVIDER=openai
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI model to use
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# CODE VALIDATION (Optional Security Feature)
# ==========================================

# Enable automatic code validation & self-correction
# WARNING: Requires more RAM & processing. Disable on 8GB devices.
ENABLE_CODE_VALIDATION=false

# Timeout for code execution (seconds)
VALIDATION_TIMEOUT=5

# ==========================================
# AUDIO TRANSCRIPTION (Speech-to-Text)
# ==========================================

# Whisper model size: tiny.en, base.en, small.en (larger = more accurate)
# For 8GB: use "tiny.en"
WHISPER_MODEL=tiny.en

# ==========================================
# PERFORMANCE TUNING
# ==========================================

# Keep model in Ollama memory indefinitely (0 = auto-unload)
# Set to -1 for always-loaded (uses more RAM but faster response)
OLLAMA_KEEP_ALIVE=-1

# ==========================================
# 8GB RAM OPTIMIZATION PROFILE
# ==========================================
#
# If you have EXACTLY 8GB RAM, uncomment below:
#
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:1b
# ENABLE_CODE_VALIDATION=false
# WHISPER_MODEL=tiny.en
# OLLAMA_KEEP_ALIVE=300
#
# Then run: ollama pull llama3.2:1b
#
